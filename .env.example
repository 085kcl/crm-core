# Supabase project URL, for example: https://project-ref.supabase.co
SUPABASE_URL=

# Preferred key for current Supabase projects. Safe for this app when RLS is enabled.
SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback for older projects. Never use the service-role key here.
SUPABASE_ANON_KEY=


# Server-only Supabase credential used by trusted integration routes.
# Prefer the current Supabase secret key. Legacy projects may use service_role.
# Never expose either value to browser code or NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# CLASSY admin -> CRM Core server-to-server bridge.
# Use a long random secret stored only in the CLASSY backend and CRM runtime.
CLASSY_BRIDGE_TOKEN=
CLASSY_BRIDGE_FORM_KEY=classy-pre-analysis


# Transactional notification worker.
# Keep all three values server-side; never expose through NEXT_PUBLIC_*.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CRM_NOTIFICATION_WORKER_TOKEN=
